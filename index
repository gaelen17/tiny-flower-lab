<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Laboratoire Fleurs GSAP</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Le conteneur vide qui attend d'être rempli par le JS -->
  <div id="grid-container"></div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      
      const svgNS = "http://www.w3.org/2000/svg";
      const container = document.getElementById('grid-container');

      // 1. LES VARIABLES PAR DÉFAUT (Ton code)
      const pathDefaut = "M50 50 C40 30 45 10 50 10 C55 10 60 30 50 50 Z";
      const couleurDefaut = "#fde2e4";
      const centreDefaut = "#c3d645";

      // 2. LE TABLEAU DE CONFIGURATION (Tes 16 lignes de laboratoire)
      const grilleConfig = Array.from({ length: 16 }, () => ({
        path: pathDefaut,
        couleur: couleurDefaut,
        centre: centreDefaut,
        nbPetales: 5
      }));

      // --- C'est ici que tu t'amuses : on modifie individuellement certaines fleurs ---
      grilleConfig[1].couleur = "#84b6f4"; // La 2ème fleur devient bleue
      
      grilleConfig[2].path = "M50 50 C35 35 38 22 50 25 C62 22 65 35 50 50 Z"; // La 3ème a un path plus large
      grilleConfig[2].couleur = "#ffb347"; // Et elle est orange
      
      grilleConfig[3].nbPetales = 8; // La 4ème a 8 pétales
      grilleConfig[3].couleur = "#b19cd9"; // Et elle est violette
      // 
      
       grilleConfig[5].path = "M50 50 C35 35 38 22 50 25 C62 22 65 35 50 50 Z"; // La 3ème a un path plus large
      grilleConfig[5].couleur = "#ffb347"; // Et elle est orange
      grilleConfig[5].nbPetales = 7; // La 5ème a 8 pétales

       grilleConfig[6].path = "M50 50 C35 35 38 22 50 25 C62 22 65 35 50 50 Z"; // La 3ème a un path plus large
      grilleConfig[6].couleur = "#ffb3a7"; // Et elle est orange
      grilleConfig[6].nbPetales = 4; // La 6ème a 8 pétales
      
 

      // 3. LA FONCTION "USINE" (création d'une fleur paramétrée)
      function createFlower(config) {
        const svg = document.createElementNS(svgNS, 'svg');
        svg.setAttribute('class', 'wp-single-flower');
        svg.setAttribute('viewBox', '0 0 100 100');
        
        const petalsGroup = document.createElementNS(svgNS, 'g');
        petalsGroup.setAttribute('class', 'petals');
        petalsGroup.setAttribute('fill', config.couleur);
        petalsGroup.setAttribute('stroke', config.couleur);
        petalsGroup.setAttribute('stroke-width', '1');

        // Boucle pour générer le bon nombre de pétales selon l'angle
        for (let i = 0; i < config.nbPetales; i++) {
          const angle = (360 / config.nbPetales) * i;
          const path = document.createElementNS(svgNS, 'path');
          path.setAttribute('d', config.path);
          // On tourne autour du centre 50,50
          path.setAttribute('transform', `rotate(${angle} 50 50)`);
          petalsGroup.appendChild(path);
        }

        const circle = document.createElementNS(svgNS, 'circle');
        circle.setAttribute('class', 'center');
        circle.setAttribute('cx', '50');
        circle.setAttribute('cy', '50');
        circle.setAttribute('r', '6');
        circle.setAttribute('fill', config.centre);

        svg.appendChild(petalsGroup);
        svg.appendChild(circle);

        return svg;
      }

      // 4. GÉNÉRATION DE LA GRILLE
      grilleConfig.forEach((config) => {
        const flowerNode = createFlower(config);
        container.appendChild(flowerNode);
      });

      // 5. TES ANIMATIONS GSAP (Appliquées à toutes les fleurs générées)
      const flowers = document.querySelectorAll('.wp-single-flower');
      const petals = document.querySelectorAll('.wp-single-flower .petals path');

      if (flowers.length > 0) {
        // Apparition en cascade (stagger)
        gsap.fromTo(flowers, 
          { opacity: 0, scale: 0, rotation: -45 },
          { opacity: 1, scale: 1, duration: 1.5, ease: "back.out(1.7)", stagger: 0.1 }
        );

        // Rotation continue
        gsap.to(flowers, {
          rotation: "+=360",
          duration: 30,
          repeat: -1,
          ease: "none"
        });

        // Scintillement
        petals.forEach(petal => {
          gsap.to(petal, {
            opacity: gsap.utils.random(0.3, 1),
            duration: gsap.utils.random(0.2, 0.8),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: gsap.utils.random(0, 2)
          });
        });
      }
    });
  </script>
</body>
</html>
</html>
